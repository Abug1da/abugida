# Backend: copy to .env and fill in values. See documentation/BACKEND_DATABASE_SETUP.md
# Do not commit .env (it is gitignored).

# Server
PORT=5000
NODE_ENV=development

# MongoDB: backend connects to the database; the host running the backend must be allowed in Atlas Network Access
MONGO_URL=
# Or use MONGODB_URI instead (e.g. for MongoDB Atlas):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/abugida

# Auth: required in production; use a strong random value
JWT_SECRET=

# Optional: only if using Cloudflare Tunnel from this host
# CLOUDFLARE_TUNNEL_TOKEN=
