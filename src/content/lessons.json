  {"id": "conversation-01", "title": "Conversation Pieces: greetings, names, origin", "kind": "vocabulary", "vocabulary": [
      {"english": "Hello / peace", "amharic": "ሰላም", "transliteration": "selam", "note": "A common greeting meaning “peace.”"},
      {"english": "Nice to meet you", "amharic": "ጤና ይስጥልኝ", "transliteration": "t’Ana yst’lgn", "note": "Literally: “May He give you health.” (On my behalf)"},
      {"english": "How are you? / Are you well?", "amharic": "ደህና ነህ? / ደህና ነሽ?", "transliteration": "dehna neh? / dehna nesh?", "note": "Use the first for a man, second for a woman."},
      {"english": "I am fine.", "amharic": "ደህና ነኝ።", "transliteration": "dehna negn", "note": "A simple response: “I am well.”"},
      {"english": "Thank you.", "amharic": "አመሰግናለሁ።", "transliteration": "ameseginalehu", "note": "Useful after greetings, help, or check-ins."},
      {"english": "What is your name?", "amharic": "ስምህ ማን ነው?", "transliteration": "simih man new?", "audience": "m"},
      {"english": "What is your name?", "amharic": "ስምሽ ማን ነው?", "transliteration": "simish man new?", "audience": "f"},
      {"english": "My name is ___.", "amharic": "ስሜ ___ ነው።", "transliteration": "sime ___ new"},
      {"english": "I am learning Amharic.", "amharic": "አማርኛ እየተማርኩ ነው።", "transliteration": "Amarigna eyetemareku new", "note": "A useful learner identity phrase."},
      {"english": "Where are you from?", "amharic": "ከየት ነው የመጣኸው? / ከየት ነህ?", "transliteration": "keyet new yemet’tahew / keyet neh", "audience": "m", "note": "“Where did you come from?”"},
      {"english": "Where are you from?", "amharic": "ከየት ነው የመጣሽው? / ከየት ነሽ?", "transliteration": "keyet new yemet’tashew / keyet nesh", "audience": "f", "note": "“Where did you come from?”"},
      {"english": "I am from ___.", "amharic": "ከ____ ነው የመጣሁት።", "transliteration": "ke____ new yemet’ahut", "note": "“I came from ___.”"}
  ]},
  {"id": "conversation-02", "title": "Conversation Pieces: time of day, check-ins, everyday needs", "kind": "vocabulary", "vocabulary": [
      {"english": "Good morning", "amharic": "እንደምን አደርክ? / እንዴት አደርክ?", "transliteration": "endemin / endiet aderk", "audience": "m", "note": "“How did you sleep/rest?”"},
      {"english": "Good morning", "amharic": "እንደምን አደርሽ? / እንዴት አደርሽ?", "transliteration": "endemin / endiet adersh", "audience": "f", "note": "“How did you sleep/rest?”"},
      {"english": "Good morning", "amharic": "እንደምን አደራችሁ? / እንዴት አደራችሁ?", "transliteration": "endemin / endiet aderachu", "audience": "group", "note": "“How did you sleep/rest?”"},
      {"english": "Good afternoon", "amharic": "እንደምን ዋልክ? / እንዴት ዋልክ?", "transliteration": "endemin / endiet walk", "audience": "m", "note": "“How was your time passed?”"},
      {"english": "Good afternoon", "amharic": "እንደምን ዋልሽ? / እንዴት ዋልሽ?", "transliteration": "endemin / endiet walsh", "audience": "f", "note": "“How was your time passed?”"},
      {"english": "Good afternoon", "amharic": "እንደምን ዋላችሁ? / እንዴት ዋላችሁ?", "transliteration": "endemin / endiet walachu", "audience": "group", "note": "“How was your time passed?”"},
      {"english": "Good evening / night", "amharic": "እንደምን አመሸህ? / እንዴት አመሸህ?", "transliteration": "endemin / endiet amesheh", "audience": "m", "note": "“How was your late stay?”"},
      {"english": "Good evening / night", "amharic": "እንደምን አመሸሽ? / እንዴት አመሸሽ?", "transliteration": "endemin / endiet ameshesh", "audience": "f", "note": "“How was your late stay?”"},
      {"english": "Good evening / night", "amharic": "እንደምን አመሻችሁ? / እንዴት አመሻችሁ?", "transliteration": "endemin / endiet ameshachu", "audience": "group", "note": "“How was your late stay?”"},
      {"english": "How is your family?", "amharic": "ቤተሰብህ እንዴት ናቸው?", "transliteration": "Betesebih endiet nachew?", "audience": "m", "note": "“Your family, how are they?”"},
      {"english": "How is your family?", "amharic": "ቤተሰብሽ እንዴት ናቸው?", "transliteration": "Betesebish endiet nachew?", "audience": "f", "note": "“Your family, how are they?”"},
      {"english": "How is your day?", "amharic": "ቀንህ እንዴት ነው?", "transliteration": "q’enih endiet new?", "audience": "m", "note": "“Your day, how is it?”"},
      {"english": "How is your day?", "amharic": "ቀንሽ እንዴት ነው?", "transliteration": "q’enish endiet new?", "audience": "f", "note": "“Your day, how is it?”"},
      {"english": "How’s everyone’s day?", "amharic": "ቀናችሁ እንዴት ነው?", "transliteration": "q’enachihu endiet new?", "audience": "group", "note": "“Your day, how is it?”"},
      {"english": "I want water.", "amharic": "ውሃ እፈልጋለሁ።", "transliteration": "wuha efeligalehu", "note": "Use for a simple need or request."},
      {"english": "I am hungry.", "amharic": "ርቦኛል።", "transliteration": "rebonyal", "note": "Everyday expression for hunger."},
      {"english": "Where is ___?", "amharic": "___ የት ነው?", "transliteration": "___ yet new?", "note": "Useful for places, objects, or destinations."},
      {"english": "Where is the bathroom?", "amharic": "መጸዳጃ ቤት የት ነው?", "transliteration": "mets’edaja bet yet new?", "note": "A practical travel phrase."},
      {"english": "Can you help me?", "amharic": "ልትረዳኝ ትችላለህ? / ልትረጂኝ ትችያለሽ?", "transliteration": "litiredagn tichilaleh? / litirejign tichiyalesh?", "note": "Use the first for a man, second for a woman."},
      {"english": "Please.", "amharic": "እባክህ / እባክሽ", "transliteration": "ebakih / ebakish", "note": "Use እባክህ for a man, እባክሽ for a woman."},
      {"english": "Excuse me / sorry.", "amharic": "ይቅርታ", "transliteration": "yikirta", "note": "Useful for getting attention or apologizing."}
  ]}
]
